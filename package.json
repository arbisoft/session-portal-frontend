{
  "name": "session-portal",
  "version": "1.3.6",
  "private": true,
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "npm": ">=10.2.4"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "build:e2e": "cp -n example.env.local .env.local && next build --turbopack",
    "start": "next start",
    "typecheck": "./node_modules/.bin/tsc --project ./tsconfig.json",
    "lint": "eslint && npm run typecheck",
    "prepare": "is-ci || husky || true",
    "release": "release-it",
    "generate:resource": "hygen generate resource",
    "postgenerate:resource": "npm run lint -- --fix",
    "sb": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "jest --verbose",
    "test:cov": "jest --coverage --verbose",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^6.0.0",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "7.3.4",
    "@mui/x-date-pickers": "^9.16.0",
    "@next/third-parties": "^15.3.4",
    "@react-oauth/google": "^0.13.5",
    "@reduxjs/toolkit": "^2.13.0",
    "@sentry/nextjs": "^11.9.0",
    "@vidstack/react": "^1.15.7",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lodash": "^4.17.23",
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.90.0",
    "react-redux": "^9.3.0",
    "react-virtuoso": "^4.18.19",
    "redux-persist": "^6.0.0",
    "redux-persist-transform-filter": "^0.0.22",
    "swiper": "^14.3.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/js": "^9.39.1",
    "@faker-js/faker": "^9.7.0",
    "@next/eslint-plugin-next": "^15.5.24",
    "@playwright/test": "^1.64.1",
    "@release-it/conventional-changelog": "^10.0.6",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-links": "^10.6.3",
    "@storybook/addon-onboarding": "^10.6.3",
    "@storybook/nextjs": "^10.6.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^30.0.0",
    "@types/js-cookie": "^3.0.3",
    "@types/lodash": "^4.17.27",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "babel-jest": "^29.7.0",
    "conventional-commits-parser": "^6.4.0",
    "dotenv": "^18.0.9",
    "eslint": "^9.38.0",
    "eslint-config-next": "^15.5.24",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.3",
    "globals": "^17.13.0",
    "husky": "^9.0.10",
    "identity-obj-proxy": "^3.0.0",
    "is-ci": "^4.1.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^29.7.0",
    "jest-fetch-mock": "^4.2.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "release-it": "^19.2.4",
    "storybook": "^10.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "whatwg-fetch": "^3.6.20"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "conventional-changelog-conventionalcommits": "^9.3.1"
  }
}
